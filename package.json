{
  "name": "dreamspace-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "build:android": "npm run build:android --workspace client",
    "build:ios": "npm run build:ios --workspace client",
    "build:mobile": "npm run build:mobile --workspace client",
    "cap:sync": "npm run cap:sync --workspace client",
    "cap:sync:ios": "npm run cap:sync:ios --workspace client",
    "cap:open": "npm run cap:open --workspace client",
    "cap:open:ios": "npm run cap:open:ios --workspace client",
    "start": "npm run start --workspace server",
    "preview": "npm run preview --workspace client"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
