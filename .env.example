# API server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,capacitor://localhost,https://localhost
# If VITE_PORT in client/.env.local changes, set this to that exact localhost origin.
# Optional and local-development only; ignored in production.
DEV_CLIENT_ORIGIN=
MONGODB_URI=mongodb://127.0.0.1:27017/dreamspace_ai
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# For a native Capacitor app calling a separate HTTPS API, set COOKIE_SAME_SITE=none.
# Secure cookies require HTTPS in production.
COOKIE_SAME_SITE=lax
# Only for testing the production build locally over http://localhost.
# Production deployments should leave this unset and use HTTPS.
SERVE_CLIENT=

# OpenAI image editing (server only). Never add this to client/.env or prefix with VITE_.
OPENAI_API_KEY=
# Optional vision model override for the photo-based space analysis step.
OPENAI_VISION_MODEL=gpt-4.1-mini

# Optional Google sign-in. Create a Web OAuth client ID and paste it here.
# The built client reads this value from /api/config at runtime. It is public;
# no client secret is used. VITE_GOOGLE_CLIENT_ID still works as a build-time override.
GOOGLE_CLIENT_ID=

# Public base URL of the deployed app. Used in password-reset emails and links.
APP_BASE_URL=http://localhost:5173
# Comma-separated emails that receive administrator access to /api/admin.
# You can also make an existing account an admin from the dashboard after the
# first administrator is configured here.
ADMIN_EMAILS=

# Transactional email for password reset links (Resend).
# Leave both empty in development; the reset link is returned in the API
# response only outside production so you can complete the flow locally.
RESEND_API_KEY=
EMAIL_FROM=DreamSpace AI <no-reply@example.com>
