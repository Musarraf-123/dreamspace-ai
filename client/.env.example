# Optional for production or Capacitor. Leave empty when using the Vite /api proxy.
# This is a public API origin, never a credential.
VITE_API_BASE_URL=
# Vite defaults to port 5173. If you change this, set matching DEV_CLIENT_ORIGIN
# in the repository-root .env file for the backend's exact-origin allowlist.
# VITE_PORT=5173
# Local development proxy target. Defaults to http://127.0.0.1:5000;
# set this if your server uses a different PORT.
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
# Optional Google sign-in build-time override. Normally you only set
# GOOGLE_CLIENT_ID on the server: the app loads it from /api/config at runtime.
# This client ID is public; never put a client secret here.
VITE_GOOGLE_CLIENT_ID=
